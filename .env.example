# --- Cuentas (obligatorio en producción) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=            # service_role key; solo servidor, nunca en el navegador
JWT_SECRET=                      # 64+ caracteres aleatorios: openssl rand -hex 32

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...    # sk_test_... para pruebas
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=          # opcional; si existe aparece el selector Mensual/Anual
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_TRIAL_DAYS=               # opcional, p. ej. 7

# --- Correo (recuperación de contraseña) ---
RESEND_API_KEY=re_...
EMAIL_FROM="PerData <no-reply@tu-dominio.com>"   # dominio verificado en Resend

# --- App ---
APP_URL=https://macro-data-explorer.vercel.app   # base para las URLs de retorno de Stripe
