{
  "cleanUrls": true,
  "crons": [{ "path": "/api/news?refresh=1", "schedule": "0 5 * * *" }],
  "rewrites": [
    { "source": "/empresa/:nemonico", "destination": "/empresa.html" }
  ],
  "functions": { "server.js": { "includeFiles": "{*.html,*.js,*.css,*.txt,*.xml,*.png,*.ico,*.svg,*.webmanifest,assets/**,data/news-cache.json,data/empresas.json,data/smv-hechos.json}" } },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
